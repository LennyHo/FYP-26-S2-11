# ── AI Keys ──────────────────────────────────────────────
# Supports multiple Gemini keys separated by commas (rotated on failure)
GEMINI_API_KEY=your_gemini_key_1,your_gemini_key_2
GROQ_API_KEY=your_groq_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
CHAT_LANGUAGE_MODE=match   # "match" to reply in user's language, or "english"

# ── General ───────────────────────────────────────────────
PORT=5000
NODE_ENV=development
APP_NAME=FYP-26-S2-11 Backend

# ── MongoDB ───────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=<appName>
MONGODB_DB_NAME=driptea_vs1
MONGODB_AUTOCONNECT=true

# ── Deployment ────────────────────────────────────────────
# Set this to your deployed backend URL in production
NEXT_PUBLIC_DRIPTEA_API_BASE=https://your-backend.onrender.com
DRIPTEA_API_BASE=https://your-backend.onrender.com
